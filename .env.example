# Database (used by backend outside Docker — in Docker, compose sets these)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=relateflows

# JWT
JWT_SECRET=change-this-to-a-random-secret-in-production

# Encryption key for stored channel credentials
ENCRYPTION_KEY=your-32-char-encryption-key-here

# Google OAuth (optional for dev)
VITE_GOOGLE_CLIENT_ID=
VITE_LINE_CLIENT_ID=
