# ── OAuth Credentials ──
VITE_GOOGLE_CLIENT_ID=
VITE_LINE_CLIENT_ID=
VITE_FACEBOOK_APP_ID=

# ── Backend API URL (frontend → backend) ──
VITE_API_URL=http://localhost:5000

# ── Backend (server.js reads these) ──
JWT_SECRET=replace-with-a-strong-random-secret-at-least-32-chars
REFRESH_JWT_SECRET=
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/relateflows
# Or use individual DB vars:
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_NAME=relateflows

ENCRYPTION_KEY=replace-with-a-32-char-encryption-key!!
DEMO_MODE=disabled
NODE_ENV=production
PORT=5000
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/calendar/callback
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
FB_APP_ID=
FB_APP_SECRET=

# ── Pool Config (optional) ──
DB_POOL_MAX=50
DB_POOL_IDLE_TIMEOUT=30000
DB_POOL_CONNECTION_TIMEOUT=10000

# ── Super Admin Demo (dev only) ──
# To log in as Super Admin (role_id=1) during development:
#   curl -X POST http://localhost:5000/api/auth/demo \
#     -H "Content-Type: application/json" \
#     -d '{"role":"super"}'
# Use the returned token as the Authorization: Bearer header.
# Never expose this endpoint in production (DEMO_MODE must be 'enabled' in env).
