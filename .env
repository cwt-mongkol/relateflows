# ── OAuth Credentials ──
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
VITE_LINE_CLIENT_ID=your-line-channel-id
VITE_FACEBOOK_APP_ID=your-facebook-app-id

# ── Backend API URL (frontend → backend) ──
VITE_API_URL=http://localhost:5000

# ── Backend (server.js reads these) ──
JWT_SECRET=replace-with-a-strong-random-secret-at-least-32-chars
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/relateflows
